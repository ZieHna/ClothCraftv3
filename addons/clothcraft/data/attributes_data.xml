<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="attribute_color" model="product.attribute">
        <field name="name">Color</field>
        <field name="display_type">color</field>
        <field name="create_variant">always</field>
        <field name="sequence">10</field>
    </record>
    <record id="color_black" model="product.attribute.value">
        <field name="name">Black</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#000000</field>
        <field name="sequence">1</field>
    </record>
    <record id="color_white" model="product.attribute.value">
        <field name="name">White</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#FFFFFF</field>
        <field name="sequence">2</field>
    </record>
    <record id="color_navy" model="product.attribute.value">
        <field name="name">Navy</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#1F2A5A</field>
        <field name="sequence">3</field>
    </record>
    <record id="color_red" model="product.attribute.value">
        <field name="name">Red</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#C62828</field>
        <field name="sequence">4</field>
    </record>
    <record id="color_gray" model="product.attribute.value">
        <field name="name">Gray</field>
        <field name="attribute_id" ref="attribute_color"/>
        <field name="html_color">#9E9E9E</field>
        <field name="sequence">5</field>
    </record>

    <record id="attribute_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="display_type">pills</field>
        <field name="create_variant">always</field>
        <field name="sequence">20</field>
    </record>
    <record id="size_xs" model="product.attribute.value">
        <field name="name">XS</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">1</field>
    </record>
    <record id="size_s" model="product.attribute.value">
        <field name="name">S</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">2</field>
    </record>
    <record id="size_m" model="product.attribute.value">
        <field name="name">M</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">3</field>
    </record>
    <record id="size_l" model="product.attribute.value">
        <field name="name">L</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">4</field>
    </record>
    <record id="size_xl" model="product.attribute.value">
        <field name="name">XL</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">5</field>
    </record>
    <record id="size_xxl" model="product.attribute.value">
        <field name="name">XXL</field>
        <field name="attribute_id" ref="attribute_size"/>
        <field name="sequence">6</field>
    </record>
</odoo>
