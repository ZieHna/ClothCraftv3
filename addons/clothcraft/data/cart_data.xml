<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Step 12: a customer's saved cart that has not changed for N days is removed (Sales settings, "Remove carts untouched for",
         default 60; 0 keeps them). The draft designs only those carts referred to are voided. -->
    <record id="ir_cron_cart_expiry" model="ir.cron">
        <field name="name">ClothCraft: remove carts untouched for a long time</field>
        <field name="model_id" ref="model_clothcraft_cart"/>
        <field name="state">code</field>
        <field name="code">model._cron_clothcraft_cart_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
