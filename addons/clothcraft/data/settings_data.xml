<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same effect as ticking "Variants" and "Lots & Serial Numbers" in Inventory/Sales Settings:
         the setting is just an extra group implied by every internal user.
         base.group_user is owned by base and flagged noupdate, so a <record> here is silently skipped
         under -u. <function> calls always run, and Command.link is idempotent. -->
    <function model="res.groups" name="write" eval="[
        [ref('base.group_user')],
        {'implied_ids': [
            Command.link(ref('product.group_product_variant')),
            Command.link(ref('stock.group_production_lot')),
        ]},
    ]"/>
</odoo>
