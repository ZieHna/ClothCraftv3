<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Phase 3: the global low-stock level (a variant is low when its on-hand quantity is below it; the Administrator changes it, and a
         variant can have a level of its own). Notifications older than N days (Settings, default 60, 0 keeps them) are removed daily. -->
    <record id="stock_threshold_global" model="clothcraft.stock.threshold">
        <field name="scope">global</field>
        <field name="threshold">5</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="ir_cron_notification_cleanup" model="ir.cron">
        <field name="name">ClothCraft: remove old notifications</field>
        <field name="model_id" ref="model_clothcraft_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_clothcraft_notification_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
