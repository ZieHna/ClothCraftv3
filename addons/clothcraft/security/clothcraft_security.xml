<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Roles. Customers are Odoo's built-in Portal users and get no ClothCraft group. -->
    <record id="res_groups_privilege_clothcraft" model="res.groups.privilege">
        <field name="name">ClothCraft</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_inventory" model="res.groups">
        <field name="name">Inventory Staff</field>
        <field name="privilege_id" ref="res_groups_privilege_clothcraft"/>
        <field name="implied_ids" eval="[
            Command.link(ref('stock.group_stock_user')),
            Command.link(ref('purchase.group_purchase_user')),
            Command.link(ref('sales_team.group_sale_salesman')),
            Command.link(ref('product.group_product_manager')),
        ]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_clothcraft"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_inventory')),
            Command.link(ref('stock.group_stock_manager')),
            Command.link(ref('purchase.group_purchase_manager')),
            Command.link(ref('sales_team.group_sale_manager')),
        ]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules -->
    <record id="garment_type_company_rule" model="ir.rule">
        <field name="name">Garment Type: multi-company</field>
        <field name="model_id" ref="model_clothcraft_garment_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="price_history_company_rule" model="ir.rule">
        <field name="name">Price History: multi-company</field>
        <field name="model_id" ref="model_clothcraft_price_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
