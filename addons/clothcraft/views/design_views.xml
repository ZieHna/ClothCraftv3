<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Step 9a. The print-fee settings: one record per company, edited by the ClothCraft Administrator (Inventory Staff may read it). -->
    <record id="design_pricing_view_form" model="ir.ui.view">
        <field name="name">clothcraft.design.pricing.form</field>
        <field name="model">clothcraft.design.pricing</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <p class="text-muted">
                        Print fee per piece = covered area in square inches × price per square inch + per size step × the size's steps
                        (XS and S none, M 1, L 2, XL 3, XXL 4). Nothing is charged when no element lands on the garment. VAT included.
                        A change applies to carts and new orders; orders already placed keep the fee they were placed with.
                    </p>
                    <group>
                        <field name="rate"/>
                        <field name="size_step"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="design_pricing_action" model="ir.actions.server">
        <field name="name">Customization pricing</field>
        <field name="model_id" ref="model_clothcraft_design_pricing"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
        <field name="group_ids" eval="[Command.link(ref('group_admin'))]"/>
    </record>

    <!-- The customers' designs, read-only for staff. -->
    <record id="design_view_list" model="ir.ui.view">
        <field name="name">clothcraft.design.list</field>
        <field name="model">clothcraft.design</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="id"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="state"/>
                <field name="covered_sq_in"/>
                <field name="layer_count"/>
                <field name="last_used"/>
            </list>
        </field>
    </record>

    <record id="design_view_form" model="ir.ui.view">
        <field name="name">clothcraft.design.form</field>
        <field name="model">clothcraft.design</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="variant_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="covered_sq_in"/>
                            <field name="layer_count"/>
                            <field name="print_px"/>
                            <field name="preview_id"/>
                            <field name="print_id"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <field name="order_line_ids" readonly="1">
                        <list>
                            <field name="order_id"/>
                            <field name="product_id"/>
                            <field name="product_uom_qty"/>
                            <field name="price_total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="design_action" model="ir.actions.act_window">
        <field name="name">Customer designs</field>
        <field name="res_model">clothcraft.design</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
