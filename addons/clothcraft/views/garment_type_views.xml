<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="garment_type_view_list" model="ir.ui.view">
        <field name="name">clothcraft.garment.type.list</field>
        <field name="model">clothcraft.garment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="garment_type_view_form" model="ir.ui.view">
        <field name="name">clothcraft.garment.type.form</field>
        <field name="model">clothcraft.garment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="garment_type_action" model="ir.actions.act_window">
        <field name="name">Garment Types</field>
        <field name="res_model">clothcraft.garment.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
