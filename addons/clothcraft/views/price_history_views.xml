<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="price_history_view_list" model="ir.ui.view">
        <field name="name">clothcraft.price.history.list</field>
        <field name="model">clothcraft.price.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" duplicate="0" import="0">
                <field name="create_date" string="Date"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="kind"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="partner_id" optional="show"/>
                <field name="description" optional="show"/>
                <field name="create_uid" string="Changed by"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="price_history_view_search" model="ir.ui.view">
        <field name="name">clothcraft.price.history.search</field>
        <field name="model">clothcraft.price.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <filter name="sale" string="Sale price" domain="[('kind', '=', 'sale')]"/>
                <filter name="extra" string="Attribute extra" domain="[('kind', '=', 'extra')]"/>
                <filter name="cost" string="Cost" domain="[('kind', '=', 'cost')]"/>
                <filter name="vendor_cost" string="Vendor price" domain="[('kind', '=', 'vendor_cost')]"/>
                <group>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="price_history_action" model="ir.actions.act_window">
        <field name="name">Price History</field>
        <field name="res_model">clothcraft.price.history</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
