<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_listing_view_list" model="ir.ui.view">
        <field name="name">clothcraft.stock.listing.list</field>
        <field name="model">clothcraft.stock.listing</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" duplicate="0" import="0">
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity"/>
                <field name="list_price"/>
                <field name="standard_price"/>
                <field name="arrival_date"/>
                <field name="supplier"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="stock_listing_view_search" model="ir.ui.view">
        <field name="name">clothcraft.stock.listing.search</field>
        <field name="model">clothcraft.stock.listing</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="lot_id"/>
            </search>
        </field>
    </record>

    <record id="stock_listing_action" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="res_model">clothcraft.stock.listing</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
