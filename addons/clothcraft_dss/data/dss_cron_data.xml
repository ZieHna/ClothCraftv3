<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The weekly DSS run, Monday 03:00 Manila (Sunday 19:00 UTC). Installed INACTIVE: the Administrator switches it on. -->
    <record id="ir_cron_dss_weekly" model="ir.cron">
        <field name="name">ClothCraft DSS: weekly run</field>
        <field name="model_id" ref="model_clothcraft_dss_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_dss_run('cron')</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="nextcall" eval="(DateTime.utcnow() + relativedelta(days=1, weekday=6)).strftime('%Y-%m-%d 19:00:00')"/>
        <field name="active" eval="False"/>
    </record>

    <!-- "Run now": fires only when the Administrator's button adds a trigger. It must stay active (Odoo ignores triggers of an inactive
         cron); its own next call is in 2999, and a triggered run leaves a future next call alone. -->
    <record id="ir_cron_dss_run_now" model="ir.cron">
        <field name="name">ClothCraft DSS: run now (on request)</field>
        <field name="model_id" ref="model_clothcraft_dss_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_dss_run('manual')</field>
        <field name="interval_number">1200</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2999-01-01 00:00:00</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
