# Copy to backend/.env (gitignored). scripts/create_api_user.py writes ODOO_API_KEY and SESSION_SECRET there for you.
ODOO_API_KEY=
# 32+ random characters: the HMAC key of the session cookie. The service will not start without it. Changing it ends every session.
# SESSION_SECRET=   (left commented on purpose: scripts/create_api_user.py adds a random one when no active SESSION_SECRET line exists)
# ODOO_URL=http://odoo:8069
# ODOO_DB=clothcraft_shop
# Browser origins allowed on state-changing requests, comma separated (the compose dev file sets the Vite ones)
# ALLOWED_ORIGINS=http://localhost:5173
# Addresses whose X-Forwarded-For / X-Forwarded-Proto are believed ('*' = anyone: tests only)
# TRUSTED_PROXIES=
# COOKIE_SECURE=true
# What the shop says about delivery. Delivery rates are not decided yet, so delivery is free.
DELIVERY_LABEL=Free delivery
# Where a bank transfer goes. PLACEHOLDERS until the shop has a real account: the order page then says "Do not send money".
BANK_NAME=Sample Bank (placeholder)
BANK_ACCOUNT_NAME=ClothCraft (placeholder)
BANK_ACCOUNT_NUMBER=0000 0000 0000 (placeholder)
# The staff test users (scripts/create_staff_users.py writes them; never printed)
# STAFF_INVENTORY_EMAIL= STAFF_INVENTORY_PASSWORD= STAFF_ADMIN_EMAIL= STAFF_ADMIN_PASSWORD=
