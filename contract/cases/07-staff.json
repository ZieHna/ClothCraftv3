[
  { "name": "staff: every staff route needs a staff session (401, one message)",
    "steps": [
      {"method":"GET","path":"/api/staff/auth/me","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"},{"op":"eq","path":"error.message","value":"Sign in to the staff dashboard to continue."}]},
      {"method":"GET","path":"/api/staff/orders","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"method":"GET","path":"/api/staff/orders/1","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"method":"POST","path":"/api/staff/orders/1/transition","body":{"to":"packed","expectedState":"confirmed"},"status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]}
    ] },
  { "name": "staff: signing in - the wrong password and an unknown email look the same, and a bad request is 400",
    "steps": [
      {"method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"not the password at all"},"status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_credentials"},{"op":"eq","path":"error.message","value":"The email or password is not right."},{"op":"absent","value":"not the password at all"}]},
      {"method":"POST","path":"/api/staff/auth/login","body":{"email":"nobody-here@example.test","password":"not the password at all"},"status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_credentials"},{"op":"eq","path":"error.message","value":"The email or password is not right."}]},
      {"method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}"},"status":400,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"bad_request"}]},
      {"method":"POST","path":"/api/staff/auth/login","body":{"email":5,"password":6},"status":400,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"bad_request"}]}
    ] },
  { "name": "staff: each role signs in, me says who, and signing out ends that session (a copy of the old cookie is dead)",
    "steps": [
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"GET","path":"/api/staff/auth/me","status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"},{"op":"eq","path":"data.user.email","value":"{{staffInventoryEmail}}"},{"op":"absent","value":"{{staffInventoryPassword}}"}]},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]},
      {"as":"adm","method":"GET","path":"/api/staff/auth/me","status":200,"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]},
      {"snapshot":"before-out","as":"inv"},
      {"as":"inv","method":"POST","path":"/api/staff/auth/logout","status":200,"shape":{"data":{"signedOut":"boolean"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.signedOut","value":true}]},
      {"as":"inv","method":"GET","path":"/api/staff/auth/me","status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"restore":"before-out","as":"inv"},
      {"as":"inv","method":"GET","path":"/api/staff/auth/me","status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"adm","method":"GET","path":"/api/staff/auth/me","status":200,"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]}
    ] },
  { "name": "staff: a customer session never opens a staff route, a staff session never opens a customer route, and the two are independent", "customers": ["shopper","both"],
    "steps": [
      {"as":"shopper","method":"GET","path":"/api/auth/me","status":200},
      {"as":"shopper","method":"GET","path":"/api/staff/orders","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"},{"op":"eq","path":"error.message","value":"Sign in to the staff dashboard to continue."}]},
      {"as":"shopper","method":"GET","path":"/api/staff/auth/me","status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"shopper","method":"POST","path":"/api/staff/orders/1/transition","body":{"to":"packed","expectedState":"confirmed"},"status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"GET","path":"/api/orders","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"},{"op":"eq","path":"error.message","value":"Sign in to place or see orders."}]},
      {"as":"inv","method":"GET","path":"/api/auth/me","status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"inv","method":"GET","path":"/api/orders/1","status":401,"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"both","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"both","method":"GET","path":"/api/staff/orders","status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}}},
      {"as":"both","method":"GET","path":"/api/auth/me","status":200,"asserts":[{"op":"eq","path":"data.user.email","value":"{{bothEmail}}"}]},
      {"as":"both","method":"POST","path":"/api/staff/auth/logout","status":200},
      {"as":"both","method":"GET","path":"/api/staff/auth/me","status":401},
      {"as":"both","method":"GET","path":"/api/auth/me","status":200,"asserts":[{"op":"eq","path":"data.user.email","value":"{{bothEmail}}"}]},
      {"as":"both","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"both","method":"POST","path":"/api/auth/logout","status":200},
      {"as":"both","method":"GET","path":"/api/auth/me","status":401},
      {"as":"both","method":"GET","path":"/api/staff/auth/me","status":200,"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]}
    ] },
  { "name": "staff: cancelling a cash-on-delivery order releases the stock it held, and a cancelled order cannot move again", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/cart/quote","body":{"lines":[{"sku":"{{staffSku3}}","quantity":1}]},"status":200,"asserts":[{"op":"eq","path":"data.lines[0].available","value":"{{staffSku3Avail}}"}]},
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku3}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku3Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"shopper","method":"POST","path":"/api/cart/quote","body":{"lines":[{"sku":"{{staffSku3}}","quantity":1}]},"status":200,"asserts":[{"op":"eq","path":"data.lines[0].available","value":"{{staffSku3Avail-1}}"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"cancelled"},{"op":"eq","path":"len:data.history","value":1},{"op":"eq","path":"data.history[0].from","value":"confirmed"},{"op":"eq","path":"data.history[0].to","value":"cancelled"},{"op":"eq","path":"data.history[0].via","value":"dashboard"},{"op":"matches","path":"data.history[0].staff","value":".+"},{"op":"eq","path":"len:data.allowed","value":0}]},
      {"as":"shopper","method":"POST","path":"/api/cart/quote","body":{"lines":[{"sku":"{{staffSku3}}","quantity":1}]},"status":200,"asserts":[{"op":"eq","path":"data.lines[0].available","value":"{{staffSku3Avail}}"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"cancelled"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.orders[0].state","value":"cancelled"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"cancelled"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"cancelled"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"cancelled"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"cancelled"}]}
    ] },
