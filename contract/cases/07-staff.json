  { "name": "staff: invalid and stale moves change nothing: unknown target, same state, a missing field, a screen that is out of date, an order that is not there", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku7}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"bank_transfer","quotedTotal":"{{staffSku7Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"awaiting_payment"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"awaiting_payment","expectedState":"awaiting_payment"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"banana","expectedState":"awaiting_payment"},"status":422,"shape":{"$ref":"ApiErrorFields"},"asserts":[{"op":"eq","path":"error.code","value":"validation"},{"op":"matches","path":"error.fields.to","value":".+"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed"},"status":400,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"bad_request"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"expectedState":"awaiting_payment"},"status":400,"asserts":[{"op":"eq","path":"error.code","value":"bad_request"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"awaiting_payment","note":5},"status":400,"asserts":[{"op":"eq","path":"error.code","value":"bad_request"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"confirmed"},"status":409,"shape":{"$ref":"ApiErrorStateChanged"},"asserts":[{"op":"eq","path":"error.code","value":"state_changed"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"},{"op":"eq","path":"error.order.id","value":"{{orderId}}"},{"op":"eq","path":"error.order.state","value":"awaiting_payment"},{"op":"eq","path":"len:error.order.history","value":0},{"op":"matches","path":"error.message","value":"Nothing was done"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"},{"op":"eq","path":"len:data.history","value":0}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/999999999/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":404,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"not_found"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/abc/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":404,"asserts":[{"op":"eq","path":"error.code","value":"not_found"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/999999999","status":404,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"not_found"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/abc","status":404,"asserts":[{"op":"eq","path":"error.code","value":"not_found"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"},{"op":"eq","path":"len:data.history","value":0}]}
    ] },
  { "name": "staff: the list: state, method and date filters, a search by reference, paging, and what a bad filter says", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
