      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}","to":"2000-01-01"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.total","value":0}]},
