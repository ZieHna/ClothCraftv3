[
  { "name": "staff: cash on delivery: confirmed, packed, shipped, delivered; each step is in the history and the customer sees the status", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku1}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku1Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.total","value":1},{"op":"eq","path":"data.orders[0].id","value":"{{orderId}}"},{"op":"eq","path":"data.orders[0].state","value":"confirmed"},{"op":"eq","path":"data.orders[0].paymentMethod","value":"cod"},{"op":"eq","path":"data.orders[0].paid","value":false},{"op":"eq","path":"data.orders[0].customer.email","value":"{{shopperEmail}}"},{"op":"eq","path":"data.orders[0].itemCount","value":1},{"op":"eq","path":"data.orders[0].total","value":"{{staffSku1Price}}"},{"op":"eq","path":"data.orders[0].reference","value":"{{orderRef}}"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.history","value":0},{"op":"eq","path":"data.allowed[0].to","value":"packed"},{"op":"eq","path":"data.allowed[1].to","value":"cancelled"},{"op":"eq","path":"data.allowed[1].confirm","value":true},{"op":"eq","path":"data.allowed[0].needsNote","value":false},{"op":"eq","path":"len:data.blocked","value":0},{"op":"eq","path":"data.customer.email","value":"{{shopperEmail}}"},{"op":"eq","path":"data.paymentMethod","value":"cod"},{"op":"eq","path":"data.lines[0].sku","value":"{{staffSku1}}"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"confirmed"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"packed"},{"op":"eq","path":"len:data.history","value":1},{"op":"eq","path":"data.history[0].from","value":"confirmed"},{"op":"eq","path":"data.history[0].to","value":"packed"},{"op":"eq","path":"data.history[0].via","value":"dashboard"},{"op":"matches","path":"data.history[0].staff","value":".+"},{"op":"eq","path":"data.allowed[0].to","value":"shipped"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"packed"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"packed"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"},{"op":"eq","path":"len:data.history","value":2},{"op":"eq","path":"data.history[1].from","value":"packed"},{"op":"eq","path":"data.history[1].to","value":"shipped"},{"op":"eq","path":"data.history[1].via","value":"dashboard"},{"op":"matches","path":"data.history[1].staff","value":".+"},{"op":"eq","path":"len:data.allowed","value":1},{"op":"eq","path":"data.allowed[0].to","value":"delivered"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"shipped"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"shipped"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"shipped"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"},{"op":"eq","path":"len:data.history","value":3},{"op":"eq","path":"data.history[2].from","value":"shipped"},{"op":"eq","path":"data.history[2].to","value":"delivered"},{"op":"eq","path":"data.history[2].via","value":"dashboard"},{"op":"matches","path":"data.history[2].staff","value":".+"},{"op":"eq","path":"len:data.allowed","value":0},{"op":"eq","path":"len:data.blocked","value":0}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.orders[0].state","value":"delivered"},{"op":"eq","path":"data.orders[0].paid","value":true}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"delivered"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"delivered"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"delivered"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"delivered"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"},{"op":"eq","path":"len:data.history","value":3}]}
    ] },
  { "name": "staff: bank transfer: awaiting payment, paid (confirmed), packed, shipped, delivered; it cannot skip a step", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku2}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"bank_transfer","quotedTotal":"{{staffSku2Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.total","value":1},{"op":"eq","path":"data.orders[0].state","value":"awaiting_payment"},{"op":"eq","path":"data.orders[0].paymentMethod","value":"bank_transfer"},{"op":"eq","path":"data.orders[0].paid","value":false}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"},{"op":"eq","path":"len:data.history","value":0},{"op":"eq","path":"data.allowed[0].to","value":"confirmed"},{"op":"eq","path":"data.allowed[1].to","value":"cancelled"},{"op":"eq","path":"len:data.blocked","value":0},{"op":"matches","path":"data.bankTransfer.paymentReference","value":"^S\\d{5,}$"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"awaiting_payment"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"awaiting_payment"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"},{"op":"eq","path":"len:data.history","value":0}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.history","value":1},{"op":"eq","path":"data.history[0].from","value":"awaiting_payment"},{"op":"eq","path":"data.history[0].to","value":"confirmed"},{"op":"eq","path":"data.history[0].via","value":"dashboard"},{"op":"matches","path":"data.history[0].staff","value":".+"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.orders[0].state","value":"confirmed"},{"op":"eq","path":"data.orders[0].paid","value":true}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"confirmed"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"packed"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"packed"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"shipped"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"},{"op":"eq","path":"len:data.history","value":4},{"op":"eq","path":"len:data.allowed","value":0}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.orders[0].paid","value":true}]}
    ] },
  { "name": "staff: cancelling a PAID bank-transfer order is for an Administrator only, with a note, and the history says REFUND DUE", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku5}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"bank_transfer","quotedTotal":"{{staffSku5Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.history","value":1},{"op":"eq","path":"data.blocked[0].to","value":"cancelled"},{"op":"matches","path":"data.blocked[0].reason","value":"Administrator"},{"op":"eq","path":"len:data.allowed","value":1},{"op":"eq","path":"data.allowed[0].to","value":"packed"}]},
      {"as":"adm","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.history","value":1},{"op":"eq","path":"len:data.blocked","value":0},{"op":"eq","path":"data.allowed[1].to","value":"cancelled"},{"op":"eq","path":"data.allowed[1].needsNote","value":true}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed","note":"I would like to cancel this"},"status":403,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"forbidden"},{"op":"eq","path":"error.currentState","value":"confirmed"}]},
      {"as":"shopper","method":"POST","path":"/api/cart/quote","body":{"lines":[{"sku":"{{staffSku5}}","quantity":1}]},"status":200,"asserts":[{"op":"eq","path":"data.lines[0].available","value":"{{staffSku5Avail-1}}"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed"},"status":422,"shape":{"$ref":"ApiErrorFields"},"asserts":[{"op":"eq","path":"error.code","value":"validation"},{"op":"matches","path":"error.fields.note","value":".+"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed","note":"ab"},"status":422,"shape":{"$ref":"ApiErrorFields"},"asserts":[{"op":"eq","path":"error.code","value":"validation"}]},
      {"as":"adm","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.history","value":1}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed","note":"Customer asked to cancel; finance refunds by transfer"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"cancelled"},{"op":"eq","path":"len:data.history","value":2},{"op":"eq","path":"data.history[1].from","value":"confirmed"},{"op":"eq","path":"data.history[1].to","value":"cancelled"},{"op":"eq","path":"data.history[1].via","value":"dashboard"},{"op":"matches","path":"data.history[1].staff","value":".+"},{"op":"startsWith","path":"data.history[1].note","value":"REFUND DUE."},{"op":"matches","path":"data.history[1].note","value":"finance refunds by transfer"}]},
      {"as":"shopper","method":"POST","path":"/api/cart/quote","body":{"lines":[{"sku":"{{staffSku5}}","quantity":1}]},"status":200,"asserts":[{"op":"eq","path":"data.lines[0].available","value":"{{staffSku5Avail}}"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"cancelled"}]}
    ] },
  { "name": "staff: two staff at once: the same move sent together is one 200 and one 409 state_changed, and the history has ONE line", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku6}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku6Price}}"},"status":201,"shape":{"data":{"$ref":"Order"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]},
      {"parallel":[{"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"confirmed"}},{"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"packed","expectedState":"confirmed"}}],"statuses":[200,409],"asserts":[{"op":"countEq","path":"results[*].body.error.code","value":"state_changed","count":1},{"op":"countEq","path":"results[*].body.data.state","value":"packed","count":1},{"op":"countEq","path":"results[*].body.error.currentState","value":"packed","count":1}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"packed"},{"op":"eq","path":"len:data.history","value":1}]},
      {"parallel":[{"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"packed"}},{"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"packed"}}],"statuses":[200,409],"asserts":[{"op":"countEq","path":"results[*].body.error.code","value":"state_changed","count":1}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetail"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"len:data.history","value":2},{"op":"countEq","path":"data.history[*].to","value":"packed","count":1}]}
    ] }
]
