[
  { "name": "tracking: cash on delivery through every step; the customer sees each step with its time and never who; the customer confirms and the order closes", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku1}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku1Price}}"},"status":201,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"data.tracking.current","value":"received"},{"op":"matches","path":"data.tracking.steps[0].reachedAt","value":"^\\d{4}-\\d{2}-\\d{2}T.*Z$"},{"op":"eq","path":"data.tracking.steps[1].reachedAt","value":null},{"op":"eq","path":"data.tracking.canConfirm","value":false},{"op":"eq","path":"data.tracking.awaitingPayment","value":false}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200,"shape":{"data":{"user":{"$ref":"StaffUser"}},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.user.role","value":"inventory"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"confirmed"},{"op":"eq","path":"len:data.allowed","value":2},{"op":"eq","path":"data.allowed[0].to","value":"shipped"},{"op":"eq","path":"data.allowed[0].direction","value":"forward"},{"op":"eq","path":"data.allowed[1].to","value":"cancelled"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed","note":"a private note for the team"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"},{"op":"eq","path":"data.history[0].actor","value":"staff"},{"op":"eq","path":"data.history[0].stepBack","value":false},{"op":"eq","path":"data.allowed[0].to","value":"out_for_delivery"},{"op":"eq","path":"len:data.allowed","value":1}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"},{"op":"eq","path":"data.tracking.current","value":"shipped"},{"op":"matches","path":"data.tracking.steps[1].reachedAt","value":"Z$"},{"op":"eq","path":"data.tracking.steps[2].reachedAt","value":null},{"op":"absent","value":"a private note"},{"op":"absent","value":"\"history\""}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"shipped"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"shipped"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"out_for_delivery"},{"op":"eq","path":"data.allowed[0].label","value":"Mark as delivered (cash collected)"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.tracking.current","value":"on_delivery"},{"op":"eq","path":"data.tracking.canConfirm","value":false}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"out_for_delivery"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"delivered"},{"op":"eq","path":"len:data.allowed","value":0},{"op":"eq","path":"len:data.history","value":3}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.tracking.current","value":"delivered"},{"op":"eq","path":"data.tracking.canConfirm","value":true},{"op":"matches","path":"data.tracking.steps[3].reachedAt","value":"Z$"},{"op":"eq","path":"data.tracking.closedAt","value":null}]},
      {"as":"shopper","method":"POST","path":"/api/orders/{{orderId}}/received","status":200,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"save":{"closedAt":"data.tracking.closedAt"},"asserts":[{"op":"eq","path":"data.state","value":"closed"},{"op":"eq","path":"data.tracking.closedBy","value":"customer"},{"op":"matches","path":"data.tracking.closedAt","value":"Z$"},{"op":"eq","path":"data.tracking.canConfirm","value":false},{"op":"eq","path":"data.tracking.current","value":"delivered"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"closed"},{"op":"eq","path":"len:data.history","value":4},{"op":"eq","path":"data.history[3].actor","value":"customer"},{"op":"eq","path":"data.history[3].via","value":"shop"},{"op":"eq","path":"data.history[3].from","value":"delivered"},{"op":"eq","path":"data.history[3].to","value":"closed"},{"op":"eq","path":"len:data.allowed","value":0}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}","state":"closed"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.total","value":1},{"op":"eq","path":"data.orders[0].state","value":"closed"},{"op":"eq","path":"data.orders[0].hasDesign","value":false},{"op":"eq","path":"data.orders[0].paid","value":true}]}
    ] },
  { "name": "tracking: bank transfer waits for payment before step 1, then goes the whole way; it cannot skip a step", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku2}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"bank_transfer","quotedTotal":"{{staffSku2Price}}"},"status":201,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"save":{"orderId":"data.id","orderRef":"data.reference"},"asserts":[{"op":"eq","path":"data.state","value":"awaiting_payment"},{"op":"eq","path":"data.tracking.awaitingPayment","value":true},{"op":"eq","path":"data.tracking.current","value":null},{"op":"eq","path":"data.tracking.steps[0].reachedAt","value":null}]},
      {"as":"shopper","method":"POST","path":"/api/orders/{{orderId}}/received","status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"awaiting_payment"}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"awaiting_payment"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":200,"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders","query":{"q":"{{orderRef}}"},"status":200,"shape":{"data":{"$ref":"StaffOrderList"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.orders[0].paid","value":true},{"op":"eq","path":"data.orders[0].state","value":"confirmed"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.tracking.awaitingPayment","value":false},{"op":"eq","path":"data.tracking.current","value":"received"},{"op":"matches","path":"data.tracking.steps[0].reachedAt","value":"Z$"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"confirmed"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed"},"status":200,"asserts":[{"op":"eq","path":"data.state","value":"shipped"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"shipped"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"},"status":200,"asserts":[{"op":"eq","path":"data.state","value":"out_for_delivery"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"out_for_delivery"},"status":200,"asserts":[{"op":"eq","path":"data.state","value":"delivered"},{"op":"eq","path":"len:data.allowed","value":0},{"op":"eq","path":"len:data.history","value":4}]}
    ] },
  { "name": "tracking: \"I received my order\" is for the owner only, only once delivered, and pressing it again changes nothing", "customers": ["shopper","other"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku5}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku5Price}}"},"status":201,"save":{"orderId":"data.id"}},
      {"as":"shopper","method":"POST","path":"/api/orders/{{orderId}}/received","status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"confirmed"},{"op":"eq","path":"error.message","value":"This order is confirmed. You can confirm you received it once it has been delivered."}]},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"out_for_delivery"},"status":200},
      {"as":"other","method":"POST","path":"/api/orders/{{orderId}}/received","status":404,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"not_found"}]},
      {"method":"POST","path":"/api/orders/{{orderId}}/received","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"inv","method":"POST","path":"/api/orders/{{orderId}}/received","status":401,"shape":{"$ref":"ApiError"},"asserts":[{"op":"eq","path":"error.code","value":"unauthorised"}]},
      {"as":"shopper","method":"POST","path":"/api/orders/abc/received","status":404,"shape":{"$ref":"ApiError"}},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"closed","expectedState":"delivered"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"delivered"}]},
      {"as":"shopper","method":"POST","path":"/api/orders/{{orderId}}/received","status":200,"save":{"closedAt":"data.tracking.closedAt"},"asserts":[{"op":"eq","path":"data.state","value":"closed"}]},
      {"as":"shopper","method":"POST","path":"/api/orders/{{orderId}}/received","status":200,"shape":{"data":{"$ref":"OrderTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"closed"},{"op":"eq","path":"data.tracking.closedAt","value":"{{closedAt}}"},{"op":"eq","path":"data.tracking.closedBy","value":"customer"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"len:data.history","value":4}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"closed","note":"try to reopen"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"}]}
    ] },
  { "name": "tracking: an Administrator steps an order back one step with a note; Inventory Staff cannot; the customer's tracker follows", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku6}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku6Price}}"},"status":201,"save":{"orderId":"data.id"}},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200,"asserts":[{"op":"eq","path":"data.user.role","value":"admin"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"},"status":200,"asserts":[{"op":"eq","path":"len:data.allowed","value":1},{"op":"eq","path":"data.allowed[0].direction","value":"forward"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"out_for_delivery","note":"the courier has not picked it up"},"status":403,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"forbidden"},{"op":"eq","path":"error.currentState","value":"out_for_delivery"}]},
      {"as":"adm","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"len:data.allowed","value":2},{"op":"eq","path":"data.allowed[1].to","value":"shipped"},{"op":"eq","path":"data.allowed[1].direction","value":"back"},{"op":"eq","path":"data.allowed[1].needsNote","value":true},{"op":"eq","path":"data.allowed[1].label","value":"Step back to shipped"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"out_for_delivery"},"status":422,"shape":{"$ref":"ApiErrorFields"},"asserts":[{"op":"eq","path":"error.code","value":"validation"},{"op":"eq","path":"error.fields.note","value":"Write a short note: say why the order is stepped back."}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"out_for_delivery","note":"the courier has not picked it up"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"shipped"},{"op":"eq","path":"data.history[2].stepBack","value":true},{"op":"eq","path":"data.history[2].from","value":"out_for_delivery"},{"op":"eq","path":"data.history[2].to","value":"shipped"},{"op":"eq","path":"data.history[2].note","value":"the courier has not picked it up"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.tracking.current","value":"shipped"},{"op":"eq","path":"data.tracking.steps[2].reachedAt","value":null},{"op":"absent","value":"courier"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"shipped","note":"further back"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"delivered","expectedState":"out_for_delivery"},"status":200},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"delivered","note":"marked too early"},"status":409,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"invalid_transition"},{"op":"eq","path":"error.currentState","value":"delivered"}]}
    ] },
  { "name": "tracking: cancelling a PAID bank-transfer order is for an Administrator only, with a note, and the history says REFUND DUE (step 11 path)", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku5}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"bank_transfer","quotedTotal":"{{staffSku5Price}}"},"status":201,"save":{"orderId":"data.id"}},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"confirmed","expectedState":"awaiting_payment"},"status":200,"asserts":[{"op":"eq","path":"data.state","value":"confirmed"}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.blocked[0].to","value":"cancelled"},{"op":"matches","path":"data.blocked[0].reason","value":"Administrator"},{"op":"eq","path":"len:data.allowed","value":1},{"op":"eq","path":"data.allowed[0].to","value":"shipped"}]},
      {"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed","note":"I would like to cancel this"},"status":403,"shape":{"$ref":"ApiErrorCurrent"},"asserts":[{"op":"eq","path":"error.code","value":"forbidden"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed"},"status":422,"shape":{"$ref":"ApiErrorFields"},"asserts":[{"op":"eq","path":"error.code","value":"validation"},{"op":"matches","path":"error.fields.note","value":"refund"}]},
      {"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"cancelled","expectedState":"confirmed","note":"Customer asked to cancel; finance refunds by transfer"},"status":200,"shape":{"data":{"$ref":"StaffOrderDetailTracked"},"simulation":{"$ref":"Simulation"}},"asserts":[{"op":"eq","path":"data.state","value":"cancelled"},{"op":"startsWith","path":"data.history[1].note","value":"REFUND DUE."},{"op":"eq","path":"data.history[1].actor","value":"staff"}]},
      {"as":"shopper","method":"GET","path":"/api/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.state","value":"cancelled"},{"op":"eq","path":"data.tracking.current","value":null},{"op":"eq","path":"data.tracking.canConfirm","value":false},{"op":"absent","value":"REFUND"}]}
    ] },
  { "name": "tracking: two staff at once: the same move sent together is one 200 and one 409 state_changed, and the history has ONE line each time", "customers": ["shopper"], "keys": ["k1"],
    "steps": [
      {"as":"shopper","method":"POST","path":"/api/orders","headers":{"Idempotency-Key":"{{k1}}"},"body":{"lines":[{"sku":"{{staffSku6}}","quantity":1}],"delivery":"{{validDelivery}}","paymentMethod":"cod","quotedTotal":"{{staffSku6Price}}"},"status":201,"save":{"orderId":"data.id"}},
      {"as":"inv","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffInventoryEmail}}","password":"{{staffInventoryPassword}}"},"status":200},
      {"as":"adm","method":"POST","path":"/api/staff/auth/login","body":{"email":"{{staffAdminEmail}}","password":"{{staffAdminPassword}}"},"status":200},
      {"parallel":[{"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed"}},{"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"shipped","expectedState":"confirmed"}}],"statuses":[200,409],"asserts":[{"op":"countEq","path":"results[*].body.error.code","value":"state_changed","count":1}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"data.state","value":"shipped"},{"op":"eq","path":"len:data.history","value":1}]},
      {"parallel":[{"as":"inv","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"}},{"as":"adm","method":"POST","path":"/api/staff/orders/{{orderId}}/transition","body":{"to":"out_for_delivery","expectedState":"shipped"}}],"statuses":[200,409],"asserts":[{"op":"countEq","path":"results[*].body.error.code","value":"state_changed","count":1}]},
      {"as":"inv","method":"GET","path":"/api/staff/orders/{{orderId}}","status":200,"asserts":[{"op":"eq","path":"len:data.history","value":2},{"op":"countEq","path":"data.history[*].to","value":"out_for_delivery","count":1}]}
    ] }
]
