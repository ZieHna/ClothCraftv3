 {
  "name": "cart: placing an order takes exactly what it ordered off the saved cart; the rest stays, unticked",
  "customers": [
   "shopper"
  ],
  "keys": [
   "k1"
  ],
  "steps": [
   {
    "as": "shopper",
    "method": "PUT",
    "path": "/api/cart",
    "body": {
     "baseVersion": 0,
     "lines": [
      {
       "sku": "{{staffSku4}}",
       "quantity": 3,
       "selected": true
      },
      {
       "sku": "{{staffSku5}}",
       "quantity": 1,
       "selected": false
      }
     ]
    },
    "status": 200,
    "shape": {
     "data": {
      "$ref": "ServerCart"
     },
     "simulation": {
      "$ref": "Simulation"
     }
    },
    "asserts": [
     {
      "op": "eq",
      "path": "data.version",
      "value": 1
     }
    ]
   },
   {
    "as": "shopper",
    "method": "POST",
    "path": "/api/orders",
    "headers": {
     "Idempotency-Key": "{{k1}}"
    },
    "body": {
     "lines": [
      {
       "sku": "{{staffSku4}}",
       "quantity": 1
      }
     ],
     "delivery": "{{validDelivery}}",
     "paymentMethod": "cod",
     "quotedTotal": "{{staffSku4Price}}"
    },
    "status": 201
   },
   {
    "as": "shopper",
    "method": "GET",
    "path": "/api/cart",
    "status": 200,
    "shape": {
     "data": {
      "$ref": "ServerCart"
     },
     "simulation": {
      "$ref": "Simulation"
     }
    },
    "asserts": [
     {
      "op": "eq",
      "path": "data.version",
      "value": 2
     },
     {
      "op": "eq",
      "path": "len:data.lines",
      "value": 2
     },
     {
      "op": "eq",
      "path": "data.lines[0].sku",
      "value": "{{staffSku4}}"
     },
     {
      "op": "eq",
      "path": "data.lines[0].quantity",
      "value": 2
     },
     {
      "op": "eq",
      "path": "data.lines[0].selected",
      "value": false
     },
     {
      "op": "eq",
      "path": "data.lines[1].sku",
      "value": "{{staffSku5}}"
     }
    ]
   },
   {
    "as": "shopper",
    "method": "POST",
    "path": "/api/orders",
    "headers": {
     "Idempotency-Key": "{{k1}}"
    },
    "body": {
     "lines": [
      {
       "sku": "{{staffSku4}}",
       "quantity": 1
      }
     ],
     "delivery": "{{validDelivery}}",
     "paymentMethod": "cod",
     "quotedTotal": "{{staffSku4Price}}"
    },
    "status": 201
   },
   {
    "as": "shopper",
    "method": "GET",
    "path": "/api/cart",
    "status": 200,
    "shape": {
     "data": {
      "$ref": "ServerCart"
     },
     "simulation": {
      "$ref": "Simulation"
     }
    },
    "asserts": [
     {
      "op": "eq",
      "path": "data.version",
      "value": 2
     },
     {
      "op": "eq",
      "path": "data.lines[0].quantity",
      "value": 2
     }
    ]
   }
  ]
 },
 {
  "name": "cart: a write from another site is refused before anything is read (403 forbidden_origin)",
  "customers": [
   "shopper"
  ],
  "steps": [
   {
    "as": "shopper",
    "method": "PUT",
    "path": "/api/cart",
    "body": {
     "baseVersion": 0,
     "lines": [
      {
       "sku": "{{staffSku1}}",
       "quantity": 1,
       "selected": false
      }
     ]
    },
    "status": 403,
    "shape": {
     "$ref": "ApiError"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "forbidden_origin"
     }
    ],
    "headers": {
     "Origin": "https://evil.example"
    }
   },
   {
    "as": "shopper",
    "method": "GET",
    "path": "/api/cart",
    "status": 200,
    "shape": {
     "data": {
      "$ref": "ServerCart"
     },
     "simulation": {
      "$ref": "Simulation"
     }
    },
    "asserts": [
     {
      "op": "eq",
      "path": "data.version",
      "value": 0
     }
    ]
   }
  ]
 }
]
