 {
  "name": "dss: Run now - two at once give one 202 and one 409 (in either order)",
  "as": "adm",
  "steps": [
   {
    "as": "adm",
    "method": "POST",
    "path": "/api/admin/auth/login",
    "body": {
     "email": "{{staffAdminEmail}}",
     "password": "{{staffAdminPassword}}"
    },
    "status": 200,
    "asserts": [
     {
      "op": "absent",
      "value": "{{staffAdminPassword}}"
     }
    ]
   },
   {
    "parallel": [
     {
      "method": "POST",
      "path": "/api/admin/dss/run-now"
     },
     {
      "method": "POST",
      "path": "/api/admin/dss/run-now"
     }
    ],
    "statuses": [
     202,
     409
    ],
    "asserts": [
     {
      "op": "countEq",
      "path": "results[*].status",
      "value": 202,
      "count": 1
     },
     {
      "op": "countEq",
      "path": "results[*].status",
      "value": 409,
      "count": 1
     },
     {
      "op": "countEq",
      "path": "results[*].body.error.code",
      "value": "run_in_progress",
      "count": 1
     },
     {
      "op": "countEq",
      "path": "results[*].body.error.message",
      "value": "A DSS run is already queued or running. It appears here when it has finished.",
      "count": 1
     },
     {
      "op": "countEq",
      "path": "results[*].body.data.state",
      "value": "queued",
      "count": 1
     }
    ]
   }
  ]
 },
 {
  "name": "dss: Run now takes no body, and a request that is not known (or not a number) is read as such",
  "as": "adm",
  "steps": [
   {
    "as": "adm",
    "method": "POST",
    "path": "/api/admin/auth/login",
    "body": {
     "email": "{{staffAdminEmail}}",
     "password": "{{staffAdminPassword}}"
    },
    "status": 200,
    "asserts": [
     {
      "op": "absent",
      "value": "{{staffAdminPassword}}"
     }
    ]
   },
   {
    "method": "POST",
    "path": "/api/admin/dss/run-now",
    "body": {
     "force": true
    },
    "status": 422,
    "shape": {
     "$ref": "ApiErrorFields"
    },
    "asserts": [
     {
      "op": "gt",
