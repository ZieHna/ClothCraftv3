 {
  "name": "dss: an unknown query name, a bad value, pageSize 101, pageSize 0 and page 0 are 422 (and a run named by the path that is not there is 404)",
  "as": "adm",
  "steps": [
   {
    "as": "adm",
    "method": "POST",
    "path": "/api/admin/auth/login",
    "body": {
     "email": "{{staffAdminEmail}}",
     "password": "{{staffAdminPassword}}"
    },
    "status": 200,
    "asserts": [
     {
      "op": "absent",
      "value": "{{staffAdminPassword}}"
     }
    ]
   },
   {
    "as": "adm",
    "method": "GET",
    "path": "/api/admin/dss/overview",
    "status": 200,
    "save": {
     "realRunId": "data.real.id",
     "simRunId": "data.simulated.id"
    }
   },
   {
    "method": "GET",
    "path": "/api/admin/dss/overview?notAName=1",
    "status": 422,
    "shape": {
     "$ref": "ApiErrorFields"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "validation"
     },
     {
      "op": "gt",
      "path": "len:error.fields.notAName",
      "value": 0
     }
    ]
   },
   {
    "method": "GET",
    "path": "/api/admin/dss/forecast/keys?notAName=1",
    "status": 422,
    "shape": {
     "$ref": "ApiErrorFields"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "validation"
     },
     {
      "op": "gt",
      "path": "len:error.fields.notAName",
      "value": 0
     }
    ]
   },
   {
    "method": "GET",
    "path": "/api/admin/dss/forecast?notAName=1",
    "status": 422,
    "shape": {
     "$ref": "ApiErrorFields"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "validation"
     },
     {
      "op": "gt",
      "path": "len:error.fields.notAName",
      "value": 0
     }
    ]
   },
   {
    "method": "GET",
    "path": "/api/admin/dss/health?notAName=1",
    "status": 422,
    "shape": {
     "$ref": "ApiErrorFields"
    },
