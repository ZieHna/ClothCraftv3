[
 {
  "name": "dss: every DSS route needs the admin cookie - no cookie and a customer cookie are 401, an employee cookie 403, the Administrator 200",
  "customers": [
   "alice"
  ],
  "steps": [
   {
    "as": "adm",
    "method": "POST",
    "path": "/api/admin/auth/login",
    "body": {
     "email": "{{staffAdminEmail}}",
     "password": "{{staffAdminPassword}}"
    },
    "status": 200,
    "asserts": [
     {
      "op": "absent",
      "value": "{{staffAdminPassword}}"
     }
    ]
   },
   {
    "as": "inv",
    "method": "POST",
    "path": "/api/staff/auth/login",
    "body": {
     "email": "{{staffInventoryEmail}}",
     "password": "{{staffInventoryPassword}}"
    },
    "status": 200
   },
   {
    "as": "adm",
    "method": "GET",
    "path": "/api/admin/dss/overview",
    "status": 200,
    "save": {
     "realRunId": "data.real.id",
     "simRunId": "data.simulated.id"
    }
   },
   {
    "as": "nobody",
    "method": "GET",
    "path": "/api/admin/dss/overview",
    "status": 401,
    "shape": {
     "$ref": "ApiError"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "unauthorised"
     },
     {
      "op": "eq",
      "path": "error.message",
      "value": "Sign in to the admin dashboard to continue."
     }
    ]
   },
   {
    "as": "alice",
    "method": "GET",
    "path": "/api/admin/dss/overview",
    "status": 401,
    "shape": {
     "$ref": "ApiError"
    },
    "asserts": [
     {
      "op": "eq",
      "path": "error.code",
      "value": "unauthorised"
     },
