# Which API the browser talks to. Either way the app calls /api on its own origin.
#   odoo : nothing is intercepted; the dev/preview proxy forwards /api to VITE_PROXY_TARGET (the API service in ../backend, run with
#          docker-compose.dev.yml). The default from step 8 on: the shop runs on the real backend.
#   mock : MSW answers /api in the browser from src/mocks/ (all data is simulated). Kept as the test double: npm run dev:mock, npm run build:mock.
VITE_API=odoo
# Address of the FastAPI service (only used when VITE_API=odoo). Docker publishes it on this machine only.
VITE_PROXY_TARGET=http://127.0.0.1:8000
# The shop's real contact address for the landing page Contact section. Left empty on purpose: it is not decided yet.
VITE_CONTACT_EMAIL=
