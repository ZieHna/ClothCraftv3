# Which API the browser talks to. Either way the app calls /api on its own origin.
#   odoo : nothing is intercepted; the dev/preview proxy forwards /api to VITE_PROXY_TARGET (the API service in ../backend). The default.
#   mock : MSW answers /api in the browser from src/mocks/ (all data is simulated). The test double: npm run dev:mock, npm run build:mock.
VITE_API=odoo
# Address of the FastAPI service (only used when VITE_API=odoo). Docker publishes it on this machine only.
VITE_PROXY_TARGET=http://127.0.0.1:8000
# The shop's real contact address for the landing page Contact section. Left empty on purpose: it is not decided yet.
VITE_CONTACT_EMAIL=
# Pro editor: shows the Simple/Pro chooser and the Switch mode action. Pro itself is not built yet, so its card does nothing
# useful. Default false: the designer opens Simple directly.
VITE_PRO_EDITOR=false
# Skeleton timing (step B): 1 makes every loading skeleton show and leave at once (0 ms delays). Set for the unit tests and for the build the
# real-mode scripts run against; leave unset for the real numbers (150 ms before a skeleton shows, 600 ms minimum; see src/lib/skeletonTiming.ts).
VITE_SKELETON_INSTANT=
