{
  "name": "clothcraft-web",
  "private": true,
  "version": "0.0.0",
  "description": "ClothCraft storefront (Vite + React + TypeScript + Tailwind). Not the video source: that is video-src/, which has its own package.json.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "garments": "node scripts/make-garment-colours.mjs"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jost": "5.3.0",
    "@fontsource/pacifico": "5.3.0",
    "fabric": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
