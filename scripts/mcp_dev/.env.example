# Made by setup.sh (never commit the real .env). Names only here.
# The dedicated database container (no network; reached only through docker exec).
MCP_CONTAINER=clothcraft-mcp-db
# That container's own superuser password: used ONLY by setup.sh and restore.sh, never by the server.
MCP_SUPERUSER_PASSWORD=
# The read-only role the server connects as, inside the container: postgresql://clothcraft_mcp:<password>@127.0.0.1:5432
MCP_DB_URL=
